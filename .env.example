# ──────────────────────────────────────────────────────────────
# CourselyLabs — variables de entorno para docker-compose.prod.yml
# ──────────────────────────────────────────────────────────────
# Copia este archivo a `.env` y RELLENA los valores marcados ⚠.
# Los valores con default se pueden dejar como están en dev/LAN.
# ──────────────────────────────────────────────────────────────

# ── Puertos expuestos al host ─────────────────────────────────
HTTP_PORT=80              # nginx del frontend (y proxy /api → backend)
MAILHOG_UI_PORT=8025      # UI de MailHog para ver emails capturados
MINIO_API_PORT=9000       # API S3 (browser baja archivos firmados desde aquí)
MINIO_CONSOLE_PORT=9001   # Consola admin de MinIO

# ── BD ────────────────────────────────────────────────────────
DB_NAME=cursos_db
DB_USER=myuser
DB_PASSWORD=changeme       # ⚠ cambia en producción

# ── Seguridad (OBLIGATORIO cambiar en producción) ─────────────
# Genera con: openssl rand -hex 64
JWT_SECRET=⚠_GENERA_CON_openssl_rand_-hex_64_⚠

# Genera con: openssl rand -hex 32
APP_ENCRYPTION_SECRET=⚠_GENERA_CON_openssl_rand_-hex_32_⚠

# Genera con: openssl rand -hex 16
APP_ENCRYPTION_SALT=⚠_GENERA_CON_openssl_rand_-hex_16_⚠

# ── Storage (MinIO) ───────────────────────────────────────────
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=courselylabs
# URL pública que verá el browser para bajar archivos firmados.
# Si los alumnos acceden por IP de LAN, ponla aquí (ej. http://192.168.1.50:9000).
STORAGE_PUBLIC_URL=http://localhost:9000

# ── Mail ──────────────────────────────────────────────────────
MAIL_FROM=noreply@courselylabs.local

# ── Frontend / CORS ───────────────────────────────────────────
# URL pública desde la que se accede al frontend (usada en emails).
FRONTEND_URL=http://localhost
# Si el frontend y el backend están en el mismo host (caso normal con
# este compose), el origen es el mismo. Si los separas, pon aquí los
# orígenes que pueden llamar al backend.
CORS_ALLOWED_ORIGINS=http://localhost

# ── Integración con echo lab ──────────────────────────────────
# URL accesible desde el contenedor del backend.
# En LAN típicamente: https://echo.lab o https://192.168.x.x
ECHO_BASE_URL=https://echo.lab
# Cert self-signed → true. En producción con Let's Encrypt → false.
ECHO_TRUST_ALL_CERTS=true
ECHO_TIMEOUT_SECONDS=8

# ── Stripe (opcional, deja en blanco si no se usa) ────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
